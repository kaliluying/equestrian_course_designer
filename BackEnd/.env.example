# 马术障碍赛路线设计器后端环境变量示例
# 复制为 BackEnd/.env 后按本地或生产环境修改。

# 基础配置
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-dev-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 数据库配置
DB_NAME=equestrian
DB_USER=equestrian
DB_PASSWORD=replace-with-local-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis 配置
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# 站点 URL，用于媒体文件和支付回调 URL
SITE_DOMAIN=localhost:8000
USE_HTTPS=false

# 邮件配置。未配置时密码重置邮件不可用。
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# 支付宝配置。未配置或密钥文件不存在时，支付接口返回 503。
ALIPAY_APPID=
ALIPAY_SELLER_ID=
ALIPAY_DEBUG=true
# 默认读取 BackEnd/equestrian/keys/app_private_key.pem
# 默认读取 BackEnd/equestrian/keys/alipay_public_key.pem

# AI 配置。未配置或调用失败时，AI 生成回退到本地规则引擎。
AI_PROVIDER=openai
API_KEY=
MODEL=gpt-4o
BASE_URL=https://api.openai.com/v1
AI_TOKEN_PRICE_PER_1K=0

# 协作分享链接
COLLAB_SHARE_TOKEN_TTL_SECONDS=3600
