# ===============================
# 马术障碍赛路线设计器 - 环境配置
# ===============================

# ========== 基础配置 ==========

# Django 调试模式
# 开发环境: true
# 生产环境: false (必须设为 false)
DJANGO_DEBUG=false

# Django 密钥
# 重要：生产环境必须设置一个强随机密钥
# 生成命令: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-keep-it-long-and-random

# 允许的主机域名（生产环境必须配置）
# 多个域名用逗号分隔
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.com

# ========== 数据库配置 ==========

# MySQL 数据库配置
DB_NAME=equestrian
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ========== Redis 配置 ==========

# Redis 主机（用于 Channels WebSocket）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ========== CORS 配置 ==========

# CORS 白名单（生产环境必须配置）
# 多个域名用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# ========== CSRF 配置 ==========

# CSRF 信任源（生产环境必须配置）
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ========== JWT Token 配置 ==========

# Token 过期时间（可选，默认已内置）
# ACCESS_TOKEN_LIFETIME: 默认 7 天
# REFRESH_TOKEN_LIFETIME: 默认 30 天

# ========== 邮件配置 ==========

# 邮件服务器配置
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ========== 支付宝配置 ==========

# 支付宝应用配置
ALIPAY_APPID=your-alipay-app-id
ALIPAY_DEBUG=false

# 支付宝密钥文件路径（相对或绝对路径）
# ALIPAY_APP_PRIVATE_KEY_PATH=equestrian/keys/app_private_key.pem
# ALIPAY_ALIPAY_PUBLIC_KEY_PATH=equestrian/keys/alipay_public_key.pem

# ========== WebSocket 协作配置 ==========

# 分享链接过期时间（秒）
# 默认: 3600 (1小时)
COLLAB_SHARE_TOKEN_TTL_SECONDS=3600

# ========== 前端配置 ==========

# 前端应用地址
FRONTEND_URL=http://localhost:5173

# ========== 站点配置 ==========

# 站点域名（用于生成绝对URL）
SITE_DOMAIN=localhost:8000

# 是否使用 HTTPS
USE_HTTPS=false

# ========== AI 服务配置 ==========

# LLM 提供商: openai 或 anthropic
# 兼容 OpenAI API 的服务 (如 MiniMax、Ollama 等) 也使用 openai
AI_PROVIDER=openai

# 配置前缀 (默认: OPENAI)
# 使用 MiniMax 时设置为 MINIMAX
# AI_PROVIDER_CONFIG=MINIMAX

# ===== OpenAI / OpenAI 兼容 API 配置 =====
# OPENAI_API_KEY: API 密钥
# OPENAI_MODEL: 模型名称 (如: gpt-4o, gpt-4o-mini)
# OPENAI_BASE_URL: API 地址 (如: https://api.openai.com/v1)
# =========================================
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== MiniMax 配置示例 =====
# 使用 MiniMax 时，设置以下环境变量:
# AI_PROVIDER=openai
# AI_PROVIDER_CONFIG=MINIMAX
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_MODEL=MiniMax-M2.5
# MINIMAX_BASE_URL=https://api.minimax.chat
# =========================================

# ===== Anthropic / Anthropic 兼容 API 配置 =====
# ANTHROPIC_API_KEY: API 密钥
# ANTHROPIC_MODEL: 模型名称 (如: claude-3-5-sonnet-20241022)
# ANTHROPIC_BASE_URL: API 地址 (如: https://api.anthropic.com)
# ==============================================
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# AI 服务参数
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# ========== 安全提醒 ==========
# 1. SECRET_KEY 必须保密，不要提交到代码仓库
# 2. 生产环境务必设置 DJANGO_DEBUG=false
# 3. CORS_ALLOWED_ORIGINS 只信任必要的域名
# 4. 数据库密码要足够复杂
# 5. 邮件密码建议使用应用专用密码
# 6. 支付宝密钥文件不要提交到代码仓库
