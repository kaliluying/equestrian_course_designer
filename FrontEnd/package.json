{
  "name": "equestrian-course-designer",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "description": "马术障碍赛场地设计",
  "author": {
    "name": "GML"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "type-check": "vue-tsc --noEmit --project tsconfig.app.json",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 4173",
    "clean": "node -e \"if (require('fs').existsSync('dist')) require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest",
    "test:run": "vitest run",
    "api-types:generate": "node scripts/generate-openapi-types.mjs ../BackEnd/openapi.json src/types/generated-api.ts",
    "api-types:check": "node scripts/generate-openapi-types.mjs ../BackEnd/openapi.json src/types/generated-api.ts --check"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/lodash": "^4.17.25",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "pinia": "^4.0.3",
    "svg2pdf.js": "^2.7.0",
    "uuid": "^14.0.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.102.0",
    "terser": "^5.50.0",
    "typescript": "~6.0.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
