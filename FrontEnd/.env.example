# 马术障碍赛路线设计器前端环境变量示例
# 复制为 FrontEnd/.env 后按本地或生产环境修改。

# 开发环境
NODE_ENV=development
VITE_API_HOST=localhost
VITE_APP_URL=http://localhost:5173
VITE_WS_CONNECT_TIMEOUT=10000
VITE_WS_RECONNECT_INTERVAL=2000
VITE_WS_MAX_RECONNECT_ATTEMPTS=5
VITE_DEBUG=true
PORT=5173
VITE_ENABLE_HTTPS=false

# 生产环境参考：
# NODE_ENV=production
# VITE_API_HOST=equestrian.top
# VITE_APP_URL=https://equestrian.top
# VITE_WS_CONNECT_TIMEOUT=10000
# VITE_WS_RECONNECT_INTERVAL=5000
# VITE_WS_MAX_RECONNECT_ATTEMPTS=3
# VITE_DEBUG=false
# PORT=80
# VITE_ENABLE_HTTPS=true
